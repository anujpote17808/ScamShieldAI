# =====================================================================
# ScamShield AI — Frontend Environment Configuration
# Copy this file to .env and fill in the value below.
# NEVER commit .env to version control.
# =====================================================================

# ------------------------------------------------------------------
# BACKEND API URL (REQUIRED)
#
# Local development:
#   VITE_API_URL=http://localhost:5001
#
# Production (Vercel) — set this in the Vercel dashboard
# under Project → Settings → Environment Variables:
#   VITE_API_URL=https://YOUR-SERVICE-NAME.onrender.com
#
# This is the ONLY environment variable the frontend uses.
# Do NOT add DATABASE_URL, JWT_SECRET, or any API keys here.
# Variables not prefixed with VITE_ are not accessible to frontend code.
# ------------------------------------------------------------------
VITE_API_URL=http://localhost:5001
