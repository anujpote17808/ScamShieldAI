# =====================================================================
# ScamShield AI — Backend Environment Configuration
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
# =====================================================================

# ------------------------------------------------------------------
# SERVER
# ------------------------------------------------------------------
PORT=5001
NODE_ENV=development

# ------------------------------------------------------------------
# DATABASE (REQUIRED)
# PostgreSQL connection string.
#
# Local development (Docker):
#   DATABASE_URL="postgresql://user:password@localhost:5432/scamshield"
#
# Production (external provider, e.g. Supabase, Neon, Railway):
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"
#
# The ?sslmode=require parameter is mandatory for most managed providers.
# ------------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------------
# JWT AUTHENTICATION (REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters. Must be kept secret.
# ------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_COOKIE_MAX_AGE_DAYS=7

# ------------------------------------------------------------------
# CORS — FRONTEND ORIGIN (REQUIRED)
# Set to the exact origin of the deployed frontend.
# No trailing slash. No wildcard.
# Example production value: https://your-app.vercel.app
# ------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------
# THREAT INTELLIGENCE PROVIDERS (OPTIONAL)
# The application falls back to local analysis when keys are absent.
# Keys must never be exposed to the frontend.
# ------------------------------------------------------------------
VIRUSTOTAL_API_KEY=
GOOGLE_WEB_RISK_API_KEY=

# ------------------------------------------------------------------
# REQUEST LIMITS (OPTIONAL — defaults shown)
# ------------------------------------------------------------------
JSON_BODY_LIMIT=16kb

# ------------------------------------------------------------------
# RATE LIMITING (OPTIONAL — defaults shown)
# All window values are in milliseconds.
# ------------------------------------------------------------------
AUTH_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_MAX=5
SCAN_RATE_LIMIT_WINDOW_MS=60000
SCAN_RATE_LIMIT_MAX=20
SCAN_CONCURRENCY_MAX=4
