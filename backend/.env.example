# ============================================================
# ScamShield AI Backend
# ============================================================

PORT=5001
NODE_ENV=development

# ============================================================
# MONGODB
# ============================================================

# Local Docker MongoDB
DATABASE_URL="mongodb://admin:password@localhost:27017/scamshield?authSource=admin"

# Production:
# DATABASE_URL="mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/scamshield?retryWrites=true&w=majority"

# ============================================================
# JWT
# ============================================================

JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_COOKIE_MAX_AGE_DAYS=7

# ============================================================
# FRONTEND
# ============================================================

FRONTEND_URL=http://localhost:5173

# ============================================================
# GMAIL SMTP
# ============================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Gmail address used to SEND OTP emails
SMTP_USER=

# Gmail APP PASSWORD
# Do NOT use your normal Gmail password.
SMTP_PASS=

# Usually the same Gmail address as SMTP_USER
MAIL_FROM=

# ============================================================
# THREAT INTELLIGENCE
# ============================================================

VIRUSTOTAL_API_KEY=
GOOGLE_WEB_RISK_API_KEY=

# ============================================================
# REQUEST LIMITS
# ============================================================

JSON_BODY_LIMIT=16kb

# ============================================================
# RATE LIMITING
# ============================================================

AUTH_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_MAX=5

SCAN_RATE_LIMIT_WINDOW_MS=60000
SCAN_RATE_LIMIT_MAX=20
SCAN_CONCURRENCY_MAX=4